{
  "expo": {
    "name": "DocVault",
    "slug": "docvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hatrigt.docvault",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock your document vault with Face ID.",
        "NSCameraUsageDescription": "Scan documents and ID cards with your camera.",
        "NSPhotoLibraryUsageDescription": "Import photos of your documents.",
        "UIBackgroundModes": [
          "processing"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7B57F8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hatrigt.docvault",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Unlock your document vault with Face ID."
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-background-task",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your document vault with Face ID."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Scan documents and ID cards with your camera.",
          "photosPermission": "Import photos of your documents.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B4CF0"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (used by expo-background-task) creates its Room database via reflection.\n-keep class androidx.work.impl.WorkDatabase_Impl { <init>(...); }\n-keep class * extends androidx.room.RoomDatabase { <init>(...); }\n-keep class androidx.work.** { *; }\n-dontwarn androidx.work.**"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F6F4FD",
          "dark": {
            "backgroundColor": "#F6F4FD"
          }
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/pdf",
              "image/*"
            ],
            "multipleShareMimeTypes": [
              "application/pdf",
              "image/*"
            ]
          },
          "ios": {
            "enabled": false
          }
        }
      ],
      "react-native-quick-crypto"
    ],
    "scheme": "docvault",
    "experiments": {
      "typedRoutes": true
    }
  }
}
