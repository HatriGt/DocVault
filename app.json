{
  "expo": {
    "name": "DocVault",
    "slug": "docvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.docvault.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock your document vault with Face ID.",
        "NSCameraUsageDescription": "Scan documents and ID cards with your camera.",
        "NSPhotoLibraryUsageDescription": "Import photos of your documents.",
        "UIBackgroundModes": [
          "processing"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B4CF0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.docvault.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Unlock your document vault with Face ID."
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-background-task",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your document vault with Face ID."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Scan documents and ID cards with your camera.",
          "photosPermission": "Import photos of your documents.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B4CF0"
        }
      ]
    ],
    "scheme": "docvault",
    "experiments": {
      "typedRoutes": true
    }
  }
}
